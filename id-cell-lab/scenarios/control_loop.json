{
  "name": "控制器闭环：双温度聚合 + 风机联动",
  "duration_ms": 12000,
  "seed": 42,
  "key": "idcell-lab-key",
  "require_link": true,
  "link": {
    "delay_ms": 2,
    "jitter_ms": 0,
    "media": "loopback",
    "topology": "p2p",
    "t_link_min_ms": 2
  },
  "devices": [
    {
      "name": "temp-01",
      "did": "00000000-00000101",
      "caps": [
        { "index": 1, "sub": 0, "label": "车间温度", "qty": "temperature", "unit": "C", "dtype": "f64", "scale": 2, "t_prod_ms": 500, "stale_ms": 3000 }
      ],
      "values": [
        { "index": 1, "sub": 0, "base": 24.0, "amplitude": 4.0, "period_ms": 8000, "noise": 0.1 }
      ]
    },
    {
      "name": "temp-02",
      "did": "00000000-00000102",
      "caps": [
        { "index": 2, "sub": 0, "label": "回风温度", "qty": "temperature", "unit": "C", "dtype": "f64", "scale": 2, "t_prod_ms": 500, "stale_ms": 3000 }
      ],
      "values": [
        { "index": 2, "sub": 0, "base": 26.0, "amplitude": 2.0, "period_ms": 6000, "noise": 0.1 }
      ]
    },
    {
      "name": "ctrl-01",
      "did": "00000000-00000103",
      "caps": [
        { "index": 3, "sub": 0, "label": "平均温度", "qty": "temperature", "unit": "C", "dtype": "f64", "scale": 2, "t_prod_ms": 500, "stale_ms": 3000 }
      ],
      "reqs": [
        { "qty": "temperature", "unit": "C", "want_ms": 500, "stale_ms": 3000 },
        { "qty": "temperature", "unit": "C", "want_ms": 500, "stale_ms": 3000 },
        { "qty": "ratio", "unit": "%", "range": [0, 100], "want_ms": 1000, "stale_ms": 5000 }
      ],
      "logic": [
        {
          "name": "average",
          "kind": "aggregate",
          "sources": ["1.0", "2.0"],
          "agg": "avg",
          "output": "3.0",
          "min_interval_ms": 200
        },
        {
          "name": "fan-control",
          "kind": "threshold",
          "input": "3.0",
          "op": ">",
          "threshold": 26,
          "on": 80,
          "off": 20,
          "target": "fan-01",
          "output": "5.0",
          "min_interval_ms": 500
        }
      ]
    },
    {
      "name": "fan-01",
      "did": "00000000-00000104",
      "caps": [
        { "index": 5, "sub": 0, "label": "风机风量", "qty": "ratio", "unit": "%", "dtype": "f64", "dir": 3, "range": [0, 100], "t_prod_ms": 500, "stale_ms": 3000 }
      ],
      "values": [
        { "index": 5, "sub": 0, "base": 20.0, "amplitude": 0.0, "period_ms": 1000, "noise": 0.0 }
      ]
    }
  ],
  "links": [
    { "a": "temp-01", "b": "ctrl-01" },
    { "a": "temp-02", "b": "ctrl-01" },
    { "a": "fan-01", "b": "ctrl-01" }
  ],
  "asserts": [
    { "kind": "stage", "device": "ctrl-01", "peer": "temp-01", "stage": "active", "description": "控制器与温度传感器进入 Active" },
    { "kind": "stage", "device": "ctrl-01", "peer": "fan-01", "stage": "active", "description": "控制器与执行器进入 Active" },
    { "kind": "logic", "op": ">=", "value": 2, "description": "聚合 / 阈值规则被触发" },
    { "kind": "writes_ok", "op": ">=", "value": 1, "description": "规则向风机下发了 WRITE" },
    { "kind": "value", "device": "ctrl-01", "index": 5, "sub": 0, "op": ">=", "value": 20, "tolerance": 0.0, "description": "收到执行器当前风量" }
  ]
}
